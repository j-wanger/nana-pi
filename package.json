{
	"name": "nana-pi",
	"version": "0.5.0",
	"description": "nana-pi bundle: seven nana-pack pi extensions (gate, post-edit, lifecycle, notify, handoff, objective, writing) + the nana-knowledge prompt-time knowledge pull + scaffold/adopt/dev skills, installable straight from this repo via `pi install git:`",
	"keywords": ["pi-package"],
	"license": "MIT",
	"repository": "github:j-wanger/nana-pi",
	"scripts": {
		"test": "node scripts/test.mjs",
		"test:locked": "node scripts/test-locked.mjs",
		"map": "node scripts/code-map.mjs --write",
		"map:check": "node scripts/code-map.mjs --check",
		"map:impact": "node scripts/code-map.mjs --impact",
		"readme:check": "node scripts/readme-check.mjs"
	},
	"pi": {
		"extensions": ["packages/nana-pack/extensions", "packages/nana-knowledge/extensions"],
		"skills": ["packages/nana-pack/skills"]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}
