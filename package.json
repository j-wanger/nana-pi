{
	"name": "nana-pi",
	"version": "0.5.0",
	"description": "nana-pi bundle: eight nana-pack pi extensions (gate, lifecycle, adoption, objective, frontier summary, writing, roster notice, rulings) + explicit local knowledge search + scaffold/adopt/dev skills, installable straight from this repo via `pi install git:`",
	"keywords": ["pi-package"],
	"license": "MIT",
	"repository": "github:j-wanger/nana-pi",
	"scripts": {
		"test": "node scripts/test.mjs",
		"test:locked": "node scripts/test-locked.mjs",
		"map": "node scripts/code-map.mjs --write",
		"map:check": "node scripts/code-map.mjs --check",
		"map:search": "node scripts/code-map.mjs --search",
		"memory:make": "node scripts/memory-make.mjs",
		"memory:shape": "node scripts/memory-shape.mjs",
		"memory:curate": "node scripts/memory-curate.mjs",
		"map:impact": "node scripts/code-map.mjs --impact",
		"map:measure": "node scripts/runtime-measure.mjs",
		"req:tree": "node scripts/requirements-tree.mjs --write",
		"readme:check": "node scripts/readme-check.mjs",
		"report": "node scripts/product-report.mjs",
		"first-look": "node scripts/first-look.mjs",
		"outside-reader": "node scripts/outside-reader.mjs",
		"visual-reader": "node scripts/visual-reader.mjs",
		"template:accept": "node scripts/template-acceptance.mjs",
		"release": "node scripts/test.mjs --pack=release && node scripts/template-release.mjs"
	},
	"pi": {
		"extensions": ["packages/nana-pack/extensions"],
		"skills": ["packages/nana-pack/skills"]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}
