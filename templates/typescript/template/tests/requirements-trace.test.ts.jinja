{%- set rq = '// req-candidate:' if adopt else '// req:' -%}
/**
 * @module tests/requirements-trace.test.ts
 * @purpose Pin the requirements rail — the checker against fixtures, then this project's REQUIREMENTS.md against the markers its suite carries.
 * @inputs the exports of tests/requirements-trace.ts, small fixture strings, a scratch project in a temp dir, and this project root
 * @outputs vitest assertions and the summary line on stdout
 * @effects disk (reads this project; writes and removes a scratch project under the OS temp dir)
 * @errors none beyond assertion failures
 */
// Two parts. The first pins the checker itself against fixtures. The second runs
// it against THIS project and fails the suite when a row's status lies — an
// `implemented` row nobody tests, or an `untested` row a test already pins. The
// checker reads test SOURCE, so a single-file run is still a full check.
//
// The `req:` markers below are the trace rail's. In ADOPT mode they are emitted as
// `req-candidate:` instead: nothing is claimed about this project until the audit
// promotes the row, and then the marker is renamed to `req:`.
//
// Fixture test sources are written as ONE physical line with \n escapes on
// purpose: a marker comment spelled on its own line in this file would be picked
// up as a real marker when the checker scans this very file.
import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { afterAll, describe, expect, test, vi } from "vitest";

import {
	check,
	EARS_ALLOWANCE_DEFAULT,
	earsOffForm,
	loadRequirements,
	printReport,
	scanSource,
	shallCounts,
	summary,
	traceProblems,
} from "./requirements-trace.js";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

const REQS = `# reqs
| ID | Requirement | Status | Evidence |
|---|---|---|---|
| R-001 | The system shall do one thing. | implemented | \`tests/a.test.ts::one\` |
| R-002 | The system shall do another. | untested | — |
| R-003 | The system shall do a third. | planned | docs/x.md |
| G-004 | The sibling shall hold. | implemented | \`other-repo:tests/b.test.ts::holds\` |
`;

const scratch: string[] = [];
afterAll(() => {
	for (const dir of scratch) rmSync(dir, { recursive: true, force: true });
});

// Shared with test_requirements_trace.py.jinja's PARITY_FIXTURES: the SAME strings and
// expected counts in both languages (astra r1 MUST 1 + MUST 4, astra r2 MUST 1 + MUST 3) —
// matching-run code-span masking that replaces a span with ONE separator, never nothing, and
// one EXPLICIT ASCII-only word-boundary rule for `shall`, case-insensitive
// (`[A-Za-z0-9_]`, never `\w` or a Unicode property): requirement rows are English prose, so
// a non-ASCII letter or digit touching "shall" counts as a BOUNDARY, not as part of a longer
// word — "shallé" carries a `shall`. This is deliberately narrower than "every Unicode word
// character" so the count never depends on the runtime's OWN Unicode database version: Node
// 22 ships Unicode 17, the rendered Python 3.14 ships Unicode 16, and an exhaustive sweep
// found 4,657 codepoints where the two disagreed on `\p{L}`/`\p{N}` membership — including
// U+088F and U+A7F1 below, assigned letters in one database, unassigned (so non-word) in the
// other. The ASCII class has no database to disagree about.
const PARITY_FIXTURES: [string, number][] = [
	["The system shall do one thing.", 1],
	["The system shall mention `shall` in backticks.", 1],
	["The system shall print ``shall``.", 1],
	["The system shall use `` `shall` `` as an example.", 1],
	['The system shall quote "shall" in output.', 2],
	["The shallower pool is shallow.", 0],
	["Shall the system respond.", 1],
	// a non-ASCII letter next to "shall" is a boundary under the ASCII-only rule: BOTH the
	// ordinary "shall" and the adjacent one count (astra r2 MUST 1; round 1 expected 1, not 2)
	["The system shall print shallé.", 2],
	["The system shall print éshall.", 2],
	["The system shall print shall_.", 1],
	["Shall.", 1],
	["No promise word here.", 0],
	["The system shall do X and shall do Y.", 2],
	// astra r2's exact counterexample and category attacks: every character below is
	// non-ASCII, so none of them block a match under the new rule — each fixture's ordinary
	// "shall" plus its adjacent "shall<char>" both count, every time, in both languages
	["The system shall print shall࢏.", 2], // U+088F: assigned letter in Unicode 17, unassigned in 16
	["The system shall print shall꟱.", 2], // U+A7F1: same cross-version split
	["The system shall print shalĺ.", 2], // U+0301 combining acute accent
	["The system shall print shall٠.", 2], // U+0660 Arabic-Indic digit zero
	["The system shall print shallⅠ.", 2], // U+2160 Roman numeral one
	["The system shall print shall².", 2], // U+00B2 superscript two
	["The system shall print shallʰ.", 2], // U+02B0 modifier letter small h (Lm)
	["The system shall print shall一.", 2], // U+4E00 CJK ideograph (Lo)
	["The system shall print shall‍.", 2], // U+200D zero-width joiner
	// astra r3 MUST 1: Python's case-INSENSITIVE matching is Unicode-aware by default, so
	// plain re.IGNORECASE made [A-Za-z] ALSO match four characters that case-fold to an
	// ASCII letter — a live contract violation, not a Unicode-version residual. Each is a
	// boundary under the ASCII-only rule, both before and after "shall" (one match: the
	// adjacent occurrence alone, no separate ordinary "shall" in these fixtures).
	["shallİ", 1], // U+0130 LATIN CAPITAL LETTER I WITH DOT ABOVE, folds to i
	["İshall", 1],
	["shallı", 1], // U+0131 LATIN SMALL LETTER DOTLESS I, folds to i
	["ıshall", 1],
	["shallſ", 1], // U+017F LATIN SMALL LETTER LONG S, folds to s
	["ſshall", 1],
	["shallK", 1], // U+212A KELVIN SIGN, folds to k
	["Kshall", 1],
	// the long s IS "shall"'s own first letter under full Unicode case folding — "ſhall"
	// must NOT count as a `shall` (the TS counts are the contract both languages must meet)
	["ſhall", 0],
	// a code span replaced by a separator, not nothing (astra r2 MUST 3): deleting it would
	// either falsely glue "sh" + "all" back into "shall", or glue a real "shall" onto what
	// follows the span
	["The system does sh`x`all nothing.", 0],
	["The system shall`x`é afterward.", 1],
	["The system shall``x``é afterward.", 1],
];

/**
 * One Requirement cell, wrapped in a minimal table and read through the real, public
 * `shallCounts()` — the actual cell-splitting and row-matching path, not the internal
 * regex called directly.
 */
function fixtureShallCount(requirementText: string): number {
	const table = `| ID | Requirement | Status | Evidence |\n|---|---|---|---|\n| R-999 | ${requirementText} | untested | — |\n`;
	return shallCounts(table).get("R-999") ?? -1;
}

describe("shall count parity (shared with the Python rail)", () => {
	test("both rails give the same count on every fixture", () => {
		for (const [text, expected] of PARITY_FIXTURES) {
			expect(fixtureShallCount(text), text).toBe(expected);
		}
	});
});

describe("loadRequirements", () => {
	test("reads id, status and whether the evidence is external", () => {
		const rows = loadRequirements(REQS);
		expect([...rows.keys()]).toEqual(["R-001", "R-002", "R-003", "G-004"]);
		expect(rows.get("R-001")).toEqual({
			status: "implemented",
			external: false,
			local: ["tests/a.test.ts::one"],
			other: [],
		});
		expect(rows.get("G-004")).toEqual({
			status: "implemented",
			external: true,
			local: [],
			other: [],
		});
	});

	test("rejects duplicate ids, unknown statuses and a pipe inside a cell", () => {
		expect(() =>
			loadRequirements(`${REQS}| R-001 | dup | untested | — |\n`),
		).toThrow(/duplicate id R-001/);
		expect(() =>
			loadRequirements(`${REQS}| R-009 | bad | done | — |\n`),
		).toThrow(/unknown status 'done'/);
		expect(() =>
			loadRequirements(`${REQS}| R-010 | a \\| b | untested | — |\n`),
		).toThrow(/R-010 has 5 cells/);
	});

	test("a row with mixed local and external evidence is not external", () => {
		const rows = loadRequirements(
			`${REQS}| R-005 | x | implemented | \`o:t::a\`, \`tests/b.test.ts::b\` |\n`,
		);
		expect(rows.get("R-005")?.external).toBe(false);
	});
});

describe("scanSource", () => {
	test("binds a marker to the test call directly below it, stacked markers merged", () => {
		const src =
			"// req: R-001 R-002\ntest('first', () => {});\n// req: R-003\n// req: G-004\nit(\"second\", () => {});\n";
		expect(scanSource(src, "x")).toEqual([
			{ ids: ["R-001", "R-002"], title: "first" },
			{ ids: ["R-003", "G-004"], title: "second" },
		]);
	});

	test("a marker binds to a mid-line call, and callNames is configurable", () => {
		// a table-driven suite declares its cases through a helper, mid-line
		const loop =
			"// req: R-001\nfor (const c of CASES) check(`a bounded page never repeats a row`, c);\n";
		expect(scanSource(loop, "x", ["test", "it", "check"])).toEqual([
			{ ids: ["R-001"], title: "a bounded page never repeats a row" },
		]);
		const guarded =
			'// req: R-002\n\tenter(w); try { check("holds under reentry", w) } finally { exit(w) }\n';
		expect(scanSource(guarded, "x", ["check"])).toEqual([
			{ ids: ["R-002"], title: "holds under reentry" },
		]);
		// a template literal keeps its interpolation verbatim, and the FIRST call on the
		// line wins. INTERP is assembled so Biome does not read it as a mistyped template.
		const INTERP = `$${"{i}"}`;
		const interpolated = `// req: R-003\n]) check(\`case ${INTERP} holds\`, () => {}); check('second', () => {});\n`;
		expect(scanSource(interpolated, "x", ["check"])[0]?.title).toBe(
			`case ${INTERP} holds`,
		);
		// a name that merely CONTAINS a call name is not a call
		expect(() =>
			scanSource("// req: R-001\ncheckProject('x');\n", "x", ["check"]),
		).toThrow(/must sit directly above/);
	});

	test("an orphan marker or a bad id fails loudly", () => {
		expect(() => scanSource("// req: R-001\nconst x = 1;\n", "x")).toThrow(
			/must sit directly above/,
		);
		expect(() => scanSource("// req: R1\ntest('t', () => {});\n", "x")).toThrow(
			/bad requirement id 'R1'/,
		);
	});
});

describe("traceProblems", () => {
	const rows = loadRequirements(
		`${REQS}| R-006 | gone | retired | — |\n| R-007 | v | violated | — |\n`,
	);

	test("flags each mismatch and nothing else", () => {
		const traced = new Map([
			["R-002", ["t::a"]],
			["R-003", ["t::b"]],
			["R-006", ["t::c"]],
			["R-007", ["t::e"]],
			["R-099", ["t::d"]],
		]);
		expect(traceProblems(rows, traced).map((p) => p.split(" ")[0])).toEqual([
			"R-099",
			"R-001",
			"R-001",
			"R-002",
			"R-003",
			"R-007",
		]);
	});

	test("clean when the status matches, external evidence counting as traced", () => {
		expect(
			traceProblems(rows, new Map([["R-001", ["tests/a.test.ts::one"]]])),
		).toEqual([]);
	});

	test("a cited local test that does not exist or does not carry the marker is a problem", () => {
		expect(
			traceProblems(rows, new Map([["R-001", ["tests/a.test.ts::other"]]])),
		).toEqual([
			"R-001 cites 'tests/a.test.ts::one' but no test with that title carries '// req: R-001'",
		]);
	});

	test("an implemented row whose evidence names no test here is a problem", () => {
		const bad = loadRequirements(
			`${REQS}| R-100 | none at all | implemented | — |
| R-101 | prose instead of a test | implemented | docs/design.md says so |
| R-102 | a half-written citation | implemented | \`tests/a.test.ts\` |
| R-103 | external plus local | implemented | \`o:tests/b.test.ts::b\`, \`tests/a.test.ts::one\` |
`,
		);
		expect(bad.get("R-102")).toEqual({
			status: "implemented",
			external: false,
			local: [],
			other: ["tests/a.test.ts"],
		});
		const problems = traceProblems(
			bad,
			new Map([
				["R-001", ["tests/a.test.ts::one"]],
				["R-100", ["tests/a.test.ts::one"]],
				["R-101", ["tests/a.test.ts::one"]],
				["R-102", ["tests/a.test.ts::one"]],
				["R-103", ["tests/a.test.ts::one"]],
			]),
		).join("\n");
		expect(problems).toMatch(
			/R-100 is 'implemented' but its evidence names no test in this repo/,
		);
		expect(problems).toMatch(
			/R-101 evidence 'docs\/design\.md says so' is not a test citation/,
		);
		expect(problems).toMatch(
			/R-102 evidence 'tests\/a\.test\.ts' is not a test citation/,
		);
		// a row mixing an external reference with a local one is satisfied
		expect(problems).not.toMatch(/R-103/);
	});

	test("the summary line counts statuses", () => {
		expect(summary(rows, new Map([["R-001", ["t::a"]]]))).toBe(
			"requirements: 6 total (2 implemented · 1 planned · 1 retired · 1 untested · 1 violated); 1 traced by tests",
		);
	});
});

describe("check over a scratch project", () => {
	test("reads the file and scans tests/ end to end", () => {
		const dir = mkdtempSync(join(tmpdir(), "req-trace-"));
		scratch.push(dir);
		mkdirSync(join(dir, "tests"));
		writeFileSync(join(dir, "REQUIREMENTS.md"), REQS);
		writeFileSync(
			join(dir, "tests", "a.test.ts"),
			"// req: R-001\ntest('one', () => {});\n",
		);
		writeFileSync(
			join(dir, "tests", "helper.ts"),
			"// req: R-002\ntest('not a test file', () => {});\n",
		);
		const { problems, traced } = check(dir);
		expect(problems).toEqual([]);
		expect([...traced]).toEqual([["R-001", ["tests/a.test.ts::one"]]]);
	});

	test("a nested test is scanned, and its citation keeps the nested path", () => {
		const dir = mkdtempSync(join(tmpdir(), "req-trace-nested-"));
		scratch.push(dir);
		mkdirSync(join(dir, "tests", "feature"), { recursive: true });
		writeFileSync(
			join(dir, "REQUIREMENTS.md"),
			REQS.replace(
				"| R-002 | The system shall do another. | untested | — |",
				`| R-002 | The system shall do another. | implemented | \`tests/feature/b.test.ts::two\` |`,
			),
		);
		writeFileSync(
			join(dir, "tests", "a.test.ts"),
			"// req: R-001\ntest('one', () => {});\n",
		);
		writeFileSync(
			join(dir, "tests", "feature", "b.test.ts"),
			"// req: R-002\ntest('two', () => {});\n",
		);
		const { problems, traced } = check(dir);
		expect(problems).toEqual([]);
		expect(traced.get("R-002")).toEqual(["tests/feature/b.test.ts::two"]);
	});

	test("an unknown id in a NESTED test fails the check", () => {
		const dir = mkdtempSync(join(tmpdir(), "req-trace-unknown-"));
		scratch.push(dir);
		mkdirSync(join(dir, "tests", "feature"), { recursive: true });
		writeFileSync(join(dir, "REQUIREMENTS.md"), REQS);
		writeFileSync(
			join(dir, "tests", "a.test.ts"),
			"// req: R-001\ntest('one', () => {});\n",
		);
		writeFileSync(
			join(dir, "tests", "feature", "b.test.ts"),
			"// req: R-999\ntest('two', () => {});\n",
		);
		expect(check(dir).problems.join("\n")).toMatch(
			/R-999 is marked on 1 test\(s\) but is not in REQUIREMENTS\.md/,
		);
	});
});

describe("check options", () => {
	test("testRoots and callNames let one repo scan several suites", () => {
		const dir = mkdtempSync(join(tmpdir(), "req-trace-roots-"));
		scratch.push(dir);
		mkdirSync(join(dir, "packages", "a", "tests"), { recursive: true });
		writeFileSync(
			join(dir, "REQUIREMENTS.md"),
			REQS.replace(
				"| R-002 | The system shall do another. | untested | — |",
				`| R-002 | The system shall do another. | implemented | \`packages/a/tests/b.test.ts::two\` |`,
			),
		);
		writeFileSync(
			join(dir, "packages", "a", "tests", "b.test.ts"),
			"// req: R-002\nfor (const c of CASES) check('two', c);\n",
		);
		// R-001's own evidence lives in the default tests/ dir, which this project has not got
		const { problems, traced } = check(dir, {
			testRoots: ["packages/a/tests"],
			callNames: ["test", "it", "check"],
		});
		expect(traced.get("R-002")).toEqual(["packages/a/tests/b.test.ts::two"]);
		expect(problems.join("\n")).toMatch(
			/R-001 is 'implemented' but no test carries/,
		);
		// a monorepo citation is a LOCAL citation: the row it backs raises nothing
		expect(problems.filter((p) => p.startsWith("R-002"))).toEqual([]);
	});
});

/**
 * This project's declared EARS allowance (astra r1 SHOULD) — the ONE place to raise it.
 * `check(ROOT)` has no project-wide config of its own, unlike Python's
 * `requirements_ears_allowance` ini option, so both call sites below read this constant
 * instead of each hard-coding (or drifting on) their own number. Default
 * EARS_ALLOWANCE_DEFAULT; an adopted project with off-form rows before they are split
 * raises this one constant, not CheckOptions.earsAllowance at each call site.
 */
const PROJECT_EARS_ALLOWANCE = EARS_ALLOWANCE_DEFAULT;

describe("this project", () => {
	test("REQUIREMENTS.md status agrees with the markers in tests/", () => {
		const result = check(ROOT, { earsAllowance: PROJECT_EARS_ALLOWANCE });
		printReport(result);
		expect(
			result.problems,
			`requirements trace FAILED:\n  ${result.problems.join("\n  ")}`,
		).toEqual([]);
	});

	{{ rq }} G-013
	test("this project: every row carries exactly one shall", () => {
		// Filtered to the EARS problem shape, not the full `problems` list above, so this
		// pins G-013 alone — and reads against PROJECT_EARS_ALLOWANCE, the one constant
		// above both call sites share.
		const result = check(ROOT, { earsAllowance: PROJECT_EARS_ALLOWANCE });
		printReport(result);
		const earsProblems = result.problems.filter((p) => / carries \d+ shall \(one is the form\)$/.test(p));
		expect(earsProblems, result.earsLine).toEqual([]);
	});
});

describe("ears form", () => {
	{{ rq }} G-014
	test("ears: a two-shall row and a no-shall row are counted, a retired one is not", () => {
		const text = `${REQS}| R-900 | The system shall do X and shall do Y. | untested | — |
| R-901 | The system does Z with no promise word. | untested | — |
| R-902 | Gone from the product. | retired | — |
`;
		const rows = loadRequirements(text);
		expect(earsOffForm(rows, shallCounts(text))).toEqual(["R-900", "R-901"]);

		// G-014: the count is reported on its OWN line, with the real count and allowance,
		// AFTER the summary line (astra r1 MUST 2) — pinned on `report`, the exact
		// structure every real caller prints verbatim, not just the off-form id list above.
		const dir = mkdtempSync(join(tmpdir(), "req-trace-ears-report-"));
		scratch.push(dir);
		writeFileSync(join(dir, "REQUIREMENTS.md"), text);
		const result = check(dir, { earsAllowance: 99 });
		expect(result.earsOffForm).toEqual(["R-900", "R-901"]);
		expect(result.earsLine).toBe("ears: 2 rows off form (allowance 99)");
		expect(result.report).toBe(`${result.line}\n${result.earsLine}`);
		expect(result.report.split("\n")).toEqual([result.line, result.earsLine]);

		// astra r2 MUST 2: the fixture above pins the COMPUTED `report`, which a mutation to
		// the PRINTING code (not the computation) would never touch. This pins the actual
		// reporting surface instead: printReport is the one function every real caller uses,
		// so spying on console.log around a call to it catches a mutation like
		// `console.log("WRONG REPORT")` inside printReport's own body.
		const logs: string[] = [];
		const spy = vi.spyOn(console, "log").mockImplementation((msg: unknown) => {
			logs.push(String(msg));
		});
		try {
			printReport(result);
		} finally {
			spy.mockRestore();
		}
		expect(logs).toEqual([result.report]);
		expect(logs[0]?.split("\n")).toEqual([result.line, result.earsLine]);
	});

	{{ rq }} G-015
	test("ears: over the allowance each off-form row is a problem, at the allowance none", () => {
		// TWO off-form rows (astra r1 MUST 2): a fixture with only one cannot tell "names
		// EACH off-form row" apart from "names the first offending row, done".
		const dir = mkdtempSync(join(tmpdir(), "req-trace-ears-"));
		scratch.push(dir);
		mkdirSync(join(dir, "tests"));
		writeFileSync(
			join(dir, "REQUIREMENTS.md"),
			`${REQS}| R-900 | The system shall do X and shall do Y. | untested | — |
| R-901 | The system shall do A and shall do B and shall do C. | untested | — |
`,
		);
		writeFileSync(
			join(dir, "tests", "a.test.ts"),
			"// req: R-001\ntest('one', () => {});\n",
		);
		const over = check(dir, { earsAllowance: 0 });
		expect(over.earsOffForm).toEqual(["R-900", "R-901"]);
		expect(over.earsLine).toBe("ears: 2 rows off form (allowance 0)");
		expect(over.problems).toContain("R-900 carries 2 shall (one is the form)");
		expect(over.problems).toContain("R-901 carries 3 shall (one is the form)");
		const atAllowance = check(dir, { earsAllowance: 2 });
		expect(
			atAllowance.problems.filter(
				(p) => p.startsWith("R-900") || p.startsWith("R-901"),
			),
		).toEqual([]);
	});

	test("seal: EARS_ALLOWANCE_DEFAULT is 0 (G-015)", () => {
		expect(EARS_ALLOWANCE_DEFAULT).toBe(0);
	});
});
