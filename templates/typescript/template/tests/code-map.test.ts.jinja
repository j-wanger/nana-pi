test("--check fails on a header dropped outside src/", () => {
	// "every module" is every module under the configured roots — tests and scripts
	// included, so a header dropped there fails the same check.
	const root = makeProject({
		"src/core/a.ts": mod("src/core/a.ts").source,
		"tests/a.test.ts": "export const x = 1;\n",
		"scripts/tool.mjs": "export const x = 1;\n",
	});
	const run = cli(root, ["--check"]);
	expect(run.code).toBe(1);
	expect(run.stdout).toMatch(/tests\/a\.test\.ts: no contract header/);
	expect(run.stdout).toMatch(/scripts\/tool\.mjs: no contract header/);
	expect(run.stdout).toMatch(/2 without a usable contract header/);
});

{{ rq }} G-010
test("--check exits non-zero on a missing header, a stale map or a reverse import", () => {
	const root = makeProject({
		"src/core/good.ts": mod("src/core/good.ts").source,
		"src/core/bad.ts": "export const x = 1;\n",
	});
	expect(cli(root, ["--write"]).code).toBe(1); // writing reports the problem too
	const missing = cli(root, ["--check"]);
	expect(missing.code).toBe(1);
	expect(missing.stdout).toMatch(/src\/core\/bad\.ts: no contract header/);
	expect(missing.stdout).toMatch(/1 without a usable contract header/);

	const clean = makeProject({ "src/core/a.ts": mod("src/core/a.ts").source });
	expect(cli(clean, ["--check"]).stdout).toMatch(
		/docs\/code-map\.md does not exist/,
	);
	expect(cli(clean, ["--write"]).code).toBe(0);
	expect(cli(clean, ["--check"]).code).toBe(0);

	// the module changes, the map does not
	writeFileSync(
		join(clean, "src/core/a.ts"),
		mod("src/core/a.ts", [], { purpose: "Do something else entirely." }).source,
	);
	const stale = cli(clean, ["--check"]);
	expect(stale.code).toBe(1);
	expect(stale.stdout).toMatch(/docs\/code-map\.md is stale against the code/);

	// a new module with no entry, then an entry whose module is gone
	cli(clean, ["--write"]);
	writeFileSync(join(clean, "src/core/b.ts"), mod("src/core/b.ts").source);
	expect(cli(clean, ["--check"]).stdout).toMatch(
		/src\/core\/b\.ts has no entry in docs\/code-map\.md/,
	);
	cli(clean, ["--write"]);
	rmSync(join(clean, "src/core/b.ts"));
	expect(cli(clean, ["--check"]).stdout).toMatch(
		/lists src\/core\/b\.ts, which is not a module/,
	);

	// a reverse import against the declared layer direction
	const reversed = makeProject({
		"src/api/ops.ts": mod("src/api/ops.ts", ["../ui/screen.js"]).source,
		"src/ui/screen.ts": mod("src/ui/screen.ts").source,
	});
	const bad = cli(reversed, ["--check"]);
	expect(bad.code).toBe(1);
	expect(bad.stdout).toMatch(/against the layer direction/);
});

