test("a malformed contract header is a named problem rather than a silent pass", () => {
	const cases: [string, RegExp][] = [
		["export const x = 1;\n", /no contract header/],
		[
			"/**\n * @module src/a.ts\n * @purpose One.\n * @inputs i\n * @outputs o\n * @errors none\n */\n",
			/no @effects/,
		],
		[
			"/**\n * @module src/a.ts\n * @inputs i\n * @purpose One.\n * @outputs o\n * @effects none\n * @errors none\n */\n",
			/out of order/,
		],
		[header("src/a.ts", { effects: "filesystem" }), /not one of none \| disk/],
		[header("src/a.ts", { effects: "none, disk" }), /'none' alongside disk/],
		[
			header("src/a.ts", { purpose: "One thing. And a second thing." }),
			/more than one sentence/,
		],
		[header("src/a.ts", { inputs: "" }), /@inputs is empty/],
		[
			"/**\n * @module src/a.ts\n * @purpose One.\n * @inputs i\n",
			/never closed/,
		],
	];
	for (const [source, expected] of cases) {
		const parsed = parseContractHeader(source);
		if (parsed.ok)
			throw new Error(`expected a problem for: ${source.slice(0, 40)}`);
		expect(parsed.problem).toMatch(expected);
	}
	// a header naming the wrong path is a graph problem, not a parse one
	const graph = buildGraph(
		[mod("src/core/a.ts", [], { module: "src/core/b.ts" })],
		config,
	);
	expect(graph.problems.join("\n")).toMatch(
		/src\/core\/a\.ts: the header's @module says 'src\/core\/b\.ts'/,
	);
});

{{ rq }} G-009
test("the rendered map carries one entry per module under its layer", () => {
	const graph = buildGraph(
		[
			mod("src/api/ops.ts", ["../core/model.js"]),
			mod("src/core/model.ts"),
			mod("src/ui/screen.ts", ["../api/ops.js"]),
		],
		config,
	);
	expect(graph.problems).toEqual([]);
	const markdown = renderMap(graph);
	expect(mapEntries(markdown).sort()).toEqual([
		"src/api/ops.ts",
		"src/core/model.ts",
		"src/ui/screen.ts",
	]);
	// the ui entry comes before the api entry, which comes before the core one
	const at = (p: string) => markdown.indexOf(`### \`${p}\``);
	expect(at("src/ui/screen.ts")).toBeLessThan(at("src/api/ops.ts"));
	expect(at("src/api/ops.ts")).toBeLessThan(at("src/core/model.ts"));
	expect(markdown).toMatch(/- \*\*callers\*\* — `src\/api\/ops\.ts`/);
	expect(markdown).toMatch(/- \*\*callees\*\* — `src\/core\/model\.ts`/);
	// deterministic: rendering the same graph twice gives the same bytes
	expect(renderMap(graph)).toBe(markdown);
});

{{ rq }} G-009
test("the import reader finds static, bare and dynamic specifiers and resolves the NodeNext .js spelling", () => {
	// The fixture spells its quotes as @ and swaps them in: a real import specifier
	// written out here would be read as an import OF THIS FILE once tests/ is mapped.
	const source = `${[
		"import { a } from @./a.js@;",
		"import @./b.js@;",
		"const { c } = await import(@./sub/c.js@);",
		"import { d } from @node:fs@;",
	]
		.join("\n")
		.replace(/@/g, '"')}\n`;
	expect(parseRelativeImports(source)).toEqual([
		"./a.js",
		"./b.js",
		"./sub/c.js",
	]);
	expect(
		resolveImport(
			"src/ui/screen.ts",
			"../api/ops.js",
			new Set(["src/api/ops.ts"]),
		),
	).toBe("src/api/ops.ts");
	expect(
		resolveImport("src/core/a.ts", "./b.ts", new Set(["src/core/b.ts"])),
	).toBe("src/core/b.ts");
});

