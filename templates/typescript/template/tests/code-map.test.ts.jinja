test("--impact also reports how many test-root modules import no mapped module at all", () => {
	const graph = buildGraph(
		[
			mod("tests/a.test.ts", ["../src/core/model.js"]),
			mod("tests/b.test.ts"),
			mod("tests/c.test.ts", ["../src/core/model.js"]),
			mod("src/core/model.ts"),
		],
		config,
	);
	expect(graph.problems).toEqual([]);
	// one of the three test modules (b) imports no mapped module at all
	expect(formatImpact(graph, ["src/core/model.ts"])).toMatch(
		/untraced tests: 1 of 3 test modules import no mapped module \(a test that only starts a process is not linked\)$/,
	);
	// a module that itself imports nothing is still 0 untraced of 0 when there are no test modules
	const noTests = buildGraph([mod("src/core/model.ts")], config);
	expect(formatImpact(noTests, ["src/core/model.ts"])).toMatch(
		/untraced tests: 0 of 0 test modules import no mapped module/,
	);
});

