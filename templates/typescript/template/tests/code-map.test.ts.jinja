	const source = `${[
		"const a = await import(new URL(@./a.js@, import.meta.url));",
		"const b = await import(new URL(@./b.js@, import.meta.url).href);",
		"const c = await import(new URL(@./c.js@, import.meta.url).pathname);",
		"const d = await import(new URL(@./d.js@, import.meta.url).href, { assert: { type: @json@ } });",
		// biome-ignore lint/suspicious/noTemplateCurlyInString: deliberately NOT a template literal in the fixture it builds — this is the non-literal form the generator must create no edge for
		"const e = await import(new URL(`./e-${n}.js`, import.meta.url).href);",
	]
		.join("\n")
		.replace(/@/g, '"')}\n`;
	expect(parseRelativeImports(source)).toEqual([
		"./a.js",
		"./b.js",
		"./c.js",
		"./d.js",
	]);
});

// NOTE: G-007 is deliberately NOT claimed by this project. The fixtures below pin
// the CHECK, not this project's own layering, so that row stays `untested` until
// the project declares real layers and a test pins them.
test("a reverse or layer-SKIPPING import is a problem, and an adjacent one is not", () => {
	const reverse = buildGraph(
		[mod("src/api/ops.ts", ["../ui/screen.js"]), mod("src/ui/screen.ts")],
		config,
	);
	expect(reverse.problems.join("\n")).toMatch(
		/src\/api\/ops\.ts: imports src\/ui\/screen\.ts against the layer direction \(api -> ui\)/,
	);

	const skipping = buildGraph(
		[mod("src/ui/screen.ts", ["../core/model.js"]), mod("src/core/model.ts")],
		config,
	);
	expect(skipping.problems.join("\n")).toMatch(
		/src\/ui\/screen\.ts: imports src\/core\/model\.ts SKIPPING a layer \(ui -> core, past api\)/,
	);

	const adjacent = buildGraph(
		[mod("src/ui/screen.ts", ["../api/ops.js"]), mod("src/api/ops.ts")],
		config,
	);
	expect(adjacent.problems).toEqual([]);

	const dangling = buildGraph([mod("src/core/a.ts", ["./gone.js"])], config);
	expect(dangling.problems.join("\n")).toMatch(
		/resolves to src\/core\/gone\.js, which is not a mapped module/,
	);
});

test("a test may import any layer, but nothing below may import a test", () => {
	// G-007 says tests may import anything: the test root is declared layerExempt, so a
	// test reaching past a layer is fine while a module reaching INTO tests is not.
	const exempt = buildGraph(
		[
			mod("tests/model.test.ts", ["../src/core/model.js"]),
			mod("src/core/model.ts"),
		],
		config,
	);
	expect(exempt.problems).toEqual([]);
	expect(exempt.modules.get("src/core/model.ts")?.callers).toEqual([
		"tests/model.test.ts",
	]);

	const inward = buildGraph(
		[
			mod("src/core/model.ts", ["../../tests/model.test.js"]),
			mod("tests/model.test.ts"),
		],
		config,
	);
	expect(inward.problems.join("\n")).toMatch(
		/against the layer direction \(core -> tests\)/,
	);
});

