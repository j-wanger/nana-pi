test("an ignored path is outside the map: not collected, and importing it is allowed", () => {
	// `ignore` is how a root that also holds non-source — a recorded fixture tree, a
	// browser-only e2e suite — stays mappable: the subtree is not collected, so no
	// header is demanded of it, and an import that lands there is external, not broken.
	const config = {
		...FIXTURE_CONFIG,
		ignore: ["src/api/fixtures", "**/*.e2e.ts"],
	};
	const root = makeProject(
		{
			"src/core/a.ts": mod("src/core/a.ts", ["../api/fixtures/recorded.js"])
				.source,
			"src/api/fixtures/recorded.ts": "export const x = 1;\n",
			"src/api/wire.e2e.ts": "export const x = 1;\n",
		},
		config,
	);
	expect(cli(root, ["--write"]).code).toBe(0);
	const run = cli(root, ["--check"]);
	expect(run.code).toBe(0);
	// the scratch project carries the real CLI under scripts/, so it is mapped too
	expect(run.stdout).toMatch(/code map: 2 modules/);
	expect(
		mapEntries(readFileSync(join(root, "docs/code-map.md"), "utf8")),
	).toEqual(["scripts/code-map.mjs", "src/core/a.ts"]);
	expect(() =>
		parseConfig(JSON.stringify({ ...FIXTURE_CONFIG, ignore: [""] })),
	).toThrow(/'ignore' must be an array of paths/);
});

{{ rq }} G-011
test("--impact gives the transitive callers and callees of a change", () => {
	const graph = buildGraph(
		[
			mod("src/core/a.ts", ["./b.js"]),
			mod("src/core/b.ts", ["./c.js"]),
			mod("src/core/c.ts"),
			mod("src/core/d.ts", ["./b.js"]),
			mod("src/core/unrelated.ts"),
		],
		config,
	);
	expect(graph.problems).toEqual([]);

	const leaf = impact(graph, ["src/core/c.ts"]);
	expect(leaf.per[0]?.callers).toEqual([
		"src/core/a.ts",
		"src/core/b.ts",
		"src/core/d.ts",
	]);
	expect(leaf.per[0]?.callees).toEqual([]);

	const top = impact(graph, ["src/core/a.ts"]);
	expect(top.per[0]?.callees).toEqual(["src/core/b.ts", "src/core/c.ts"]);
	expect(top.per[0]?.callers).toEqual([]);

	// the union over several changed files excludes the changed files themselves
	const both = impact(graph, ["src/core/b.ts", "src/core/c.ts"]);
	expect(both.callers).toEqual(["src/core/a.ts", "src/core/d.ts"]);
	expect(both.callees).toEqual([]);

	// a path that is not a module is reported as such, not answered with an empty closure
	expect(impact(graph, ["src/core/nope.ts"]).per[0]?.known).toBe(false);

	// and through the real CLI
	const root = makeProject({
		"src/core/a.ts": mod("src/core/a.ts", ["./b.js"]).source,
		"src/core/b.ts": mod("src/core/b.ts").source,
	});
	const run = cli(root, ["--impact", "src/core/b.ts"]);
	expect(run.code).toBe(0);
	expect(run.stdout).toMatch(/transitive callers \(1\): src\/core\/a\.ts/);
	expect(run.stdout).toMatch(/transitive callees \(0\): —/);
});

