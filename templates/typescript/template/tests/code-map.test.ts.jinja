test("an exemption must name a real module and say why", () => {
	const noReason = parseConfig(
		JSON.stringify({ ...FIXTURE_CONFIG, exempt: [{ path: "src/core/a.ts" }] }),
	);
	expect(
		buildGraph(
			[{ path: "src/core/a.ts", source: "export const x = 1;\n" }],
			noReason,
		).problems.join("\n"),
	).toMatch(/exempt path 'src\/core\/a\.ts' has no reason/);

	const gone = parseConfig(
		JSON.stringify({
			...FIXTURE_CONFIG,
			exempt: [{ path: "src/core/gone.ts", reason: "pinned" }],
		}),
	);
	expect(buildGraph([mod("src/core/a.ts")], gone).problems.join("\n")).toMatch(
		/exempt path 'src\/core\/gone\.ts' is not a module/,
	);

	// a malformed entry is a config error, not a silent skip
	expect(() =>
		parseConfig(
			JSON.stringify({ ...FIXTURE_CONFIG, exempt: [{ reason: "no path" }] }),
		),
	).toThrow(/exempt\[0\] must be an object with a non-empty 'path'/);
});

