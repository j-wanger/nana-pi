{%- set rq = '// req-candidate:' if adopt else '// req:' -%}
/**
 * @module tests/code-map.test.ts
 * @purpose Pin the code map — the header parser, the renderer, the layer rules, the impact walk, and this project's own headers and rendered map.
 * @inputs the exports of scripts/code-map.mjs, fixture module sources, a scratch project carrying the real CLI, and this project root
 * @outputs vitest assertions and the check summary line on stdout
 * @effects disk (reads this project; writes and removes a scratch project under the OS temp dir), process (spawns the real CLI)
 * @errors none beyond assertion failures
 */
// The `req:` markers below are the trace rail's. In ADOPT mode they are emitted as
// `req-candidate:` instead: nothing is claimed about this project until the audit
// promotes the row, and then the marker is renamed to `req:`.
//
// The failure paths run through the REAL CLI: a temp project gets a copy of
// scripts/code-map.mjs plus a code-map.config.json, and the test spawns it
// there, so what is checked is the command the suite and the post-edit gate
// actually run, including its exit code.
import { execFileSync } from "node:child_process";
import {
	copyFileSync,
	mkdirSync,
	mkdtempSync,
	readFileSync,
	rmSync,
	writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { afterAll, expect, test } from "vitest";

import {
	buildGraph,
	checkRepo,
	formatImpact,
	HEADER_TAGS,
	impact,
	isLayerExempt,
	loadConfig,
	mapEntries,
	parseConfig,
	parseContractHeader,
	parseRelativeImports,
	renderMap,
	resolveImport,
} from "../scripts/code-map.mjs";

const PROJECT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

// the same shape the template ships: src, the scripts and the test root, the test
// root exempt from the layer direction (G-007)
const FIXTURE_CONFIG = {
	roots: ["src", "scripts", { path: "tests", layerExempt: true }],
	moduleExtensions: [".ts", ".mjs"],
	mapPath: "docs/code-map.md",
	packages: [{ id: "root", prefix: "" }],
	layers: [
		{ id: "tests", title: "Tests", blurb: "The suite.", match: "^tests/" },
		{ id: "scripts", title: "Scripts", blurb: "The CLIs.", match: "^scripts/" },
		{ id: "ui", title: "UI", blurb: "The screens.", match: "^src/ui/" },
		{ id: "api", title: "API", blurb: "The wire.", match: "^src/api/" },
		{ id: "core", title: "Core", blurb: "The model.", match: "^src/" },
	],
};
const config = parseConfig(JSON.stringify(FIXTURE_CONFIG));

const header = (path: string, over: Record<string, string> = {}): string => {
	const f: Record<string, string> = {
		module: path,
		purpose: "Do the one thing this module is for.",
		inputs: "a thing",
		outputs: "another thing",
		effects: "none",
		errors: "none",
		...over,
	};
	return `/**\n${HEADER_TAGS.map((t: string) => ` * @${t} ${f[t]}`).join("\n")}\n */\n`;
};

const mod = (
	path: string,
	imports: string[] = [],
	over: Record<string, string> = {},
) => ({
	path,
	source: `${header(path, over)}${imports.map((i) => `import { x } from "${i}";`).join("\n")}\n`,
});

const scratch: string[] = [];
afterAll(() => {
	for (const dir of scratch) rmSync(dir, { recursive: true, force: true });
});

/** A temp project carrying the real CLI, so the spawned command is the real one. */
function makeProject(
	files: Record<string, string>,
	config: object = FIXTURE_CONFIG,
): string {
	const root = mkdtempSync(join(tmpdir(), "code-map-"));
	scratch.push(root);
	mkdirSync(join(root, "scripts"));
	copyFileSync(
		join(PROJECT, "scripts", "code-map.mjs"),
		join(root, "scripts", "code-map.mjs"),
	);
	mkdirSync(join(root, "docs"));
	writeFileSync(
		join(root, "code-map.config.json"),
		JSON.stringify(config, null, 2),
	);
	for (const [path, source] of Object.entries(files)) {
		mkdirSync(dirname(join(root, path)), { recursive: true });
		writeFileSync(join(root, path), source);
	}
	return root;
}

function cli(root: string, args: string[]): { code: number; stdout: string } {
	try {
		return {
			code: 0,
			stdout: execFileSync(
				process.execPath,
				[join(root, "scripts", "code-map.mjs"), ...args],
				{
					cwd: root,
					encoding: "utf8",
				},
			),
		};
	} catch (err) {
		const e = err as { status?: number; stdout?: string; stderr?: string };
		return {
			code: e.status ?? 1,
			stdout: `${e.stdout ?? ""}${e.stderr ?? ""}`,
		};
	}
}

{{ rq }} G-004
test("a contract header parses into the six fixed fields", () => {
	const source = `${header("src/core/thing.ts", {
		effects: "database (reads read-only), disk (writes the pointer)",
		errors: "NotFound",
	})}\n// the prose header stays below the contract block\nexport const x = 1;\n`;
	const parsed = parseContractHeader(source);
	if (!parsed.ok) throw new Error(parsed.problem);
	expect(Object.keys(parsed.fields)).toEqual([...HEADER_TAGS]);
	expect(parsed.fields.module).toBe("src/core/thing.ts");
	// a parenthetical qualifier may carry commas without splitting the effects list
	expect(parsed.fields.effects).toBe(
		"database (reads read-only), disk (writes the pointer)",
	);
});

