test("a declared exemption keeps the module in the map without a header", () => {
	// A module whose CONTENT is pinned elsewhere (a fixture a published study hashes)
	// cannot take a header without invalidating that pin. It stays mapped and keeps its
	// edges; what it loses is the header — and it has to say why.
	const reason = "content-pinned by study sha256 abc123";
	const pinned = parseConfig(
		JSON.stringify({
			...FIXTURE_CONFIG,
			exempt: [{ path: "src/core/pinned.ts", reason }],
		}),
	);
	const graph = buildGraph(
		[
			mod("src/core/a.ts", ["./pinned.js"]),
			{
				path: "src/core/pinned.ts",
				source: "export const ROWS = [1, 2, 3];\n",
			},
		],
		pinned,
	);
	expect(graph.problems).toEqual([]);
	expect(graph.modules.get("src/core/pinned.ts")?.exemptReason).toBe(reason);
	const markdown = renderMap(graph);
	expect(mapEntries(markdown)).toContain("src/core/pinned.ts");
	expect(markdown).toContain(`- **exempt** — ${reason}`);
	expect(markdown.split("### `src/core/pinned.ts`")[1]).not.toMatch(
		/\*\*purpose\*\*/,
	);
	// the edge still counts, so --impact still sees it
	expect(graph.modules.get("src/core/pinned.ts")?.callers).toEqual([
		"src/core/a.ts",
	]);

	// through the real CLI: the exempt module is exempt, not headerless
	const root = makeProject(
		{ "src/core/pinned.ts": "export const ROWS = [1, 2, 3];\n" },
		{ ...FIXTURE_CONFIG, exempt: [{ path: "src/core/pinned.ts", reason }] },
	);
	expect(cli(root, ["--write"]).code).toBe(0);
	const run = cli(root, ["--check"]);
	expect(run.code, run.stdout).toBe(0);
	expect(run.stdout).toMatch(/0 without a usable contract header; 1 exempt/);
});

