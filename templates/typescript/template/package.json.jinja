{
	"name": "{{ project_slug }}",
	"version": "0.1.0",
	"description": "{{ description }}",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest --run",
		"map": "node scripts/code-map.mjs",
		"map:check": "node scripts/code-map.mjs --check",
		"map:impact": "node scripts/code-map.mjs --impact",
		"readme:check": "node scripts/readme-check.mjs",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm readme:check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/node": "^22.0.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
