def test_check_exits_non_zero_on_missing_header_stale_map_or_reverse_import(tmp_path: Path) -> None:
    headerless = write_project(
        tmp_path / "headerless",
        {"src/demo/good.py": mod("src/demo/good.py"), "src/demo/bad.py": "VALUE = 1\n"},
    )
    assert cli(headerless, "--write")[0] == 1  # writing reports the problem too
    code, out = cli(headerless, "--check")
    assert code == 1
    assert "src/demo/bad.py: no contract header" in out
    assert "1 without a usable contract header" in out

    clean = write_project(tmp_path / "clean", {"src/demo/a.py": mod("src/demo/a.py")})
    assert "docs/code-map.md does not exist" in cli(clean, "--check")[1]
    assert cli(clean)[0] == 0
    assert cli(clean, "--check")[0] == 0

    # the module changes, the map does not
    (clean / "src/demo/a.py").write_text(mod("src/demo/a.py", purpose="Do something else entirely."), encoding="utf-8")
    code, out = cli(clean, "--check")
    assert code == 1
    assert "docs/code-map.md is stale against the code" in out

    # a new module with no entry, then an entry whose module is gone
    cli(clean)
    (clean / "src/demo/b.py").write_text(mod("src/demo/b.py"), encoding="utf-8")
    assert "src/demo/b.py has no entry in docs/code-map.md" in cli(clean, "--check")[1]
    cli(clean)
    (clean / "src/demo/b.py").unlink()
    assert "lists src/demo/b.py, which is not a module" in cli(clean, "--check")[1]

    reversed_layers = write_project(
        tmp_path / "reversed",
        {
            "src/demo/api/ops.py": mod("src/demo/api/ops.py", ["from ..ui import screen"]),
            "src/demo/ui/screen.py": mod("src/demo/ui/screen.py"),
        },
    )
    code, out = cli(reversed_layers, "--check")
    assert code == 1
    assert "against the layer direction" in out


