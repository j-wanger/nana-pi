def test_this_project_headers_and_map_are_current() -> None:
    graph, _markdown, problems, line = check_project(PROJECT)
    print(line)  # the suite's own summary line
    assert problems == [], f"{line}\n" + "\n".join(problems)
    on_disk = (PROJECT / load_config(PROJECT).map_path).read_text(encoding="utf-8")
    assert len(map_entries(on_disk)) == len(graph.order)
    assert code_map.main(["--check"], PROJECT) == 0
