def test_a_wrapped_header_field_joins_its_continuation_lines() -> None:
    source = (
        '"""@module src/demo/p.py\n@purpose One thing.\n@inputs the first part\n'
        "  and the wrapped rest\n@outputs a value\n@effects disk\n@errors none\n\n"
        'Prose may follow a blank line.\n"""\n'
    )
    fields, problem = parse_contract_header(source)
    assert problem is None, problem
    assert fields is not None
    assert fields["inputs"] == "the first part and the wrapped rest"


