def test_a_literal_dynamic_import_is_an_edge_and_a_computed_one_is_a_problem() -> None:
    for line in (
        'importlib.import_module("demo.late")',
        'importlib.import_module(".late", __package__)',
        '__import__("demo.late")',
    ):
        graph = build_graph(
            {
                "src/demo/__init__.py": mod("src/demo/__init__.py", ["import importlib", line]),
                "src/demo/late.py": mod("src/demo/late.py"),
            },
            CONFIG,
        )
        assert graph.problems == [], f"{line}: {graph.problems}"
        assert graph.modules["src/demo/__init__.py"].callees == ["src/demo/late.py"], line
        assert graph.modules["src/demo/late.py"].callers == ["src/demo/__init__.py"], line

    # a name the generator cannot read is reported, never silently dropped
    computed = build_graph(
        {
            "src/demo/__init__.py": mod("src/demo/__init__.py", ["import importlib", "importlib.import_module(name)"]),
            "src/demo/late.py": mod("src/demo/late.py"),
        },
        CONFIG,
    )
    assert any("unmapped dynamic import" in p for p in computed.problems), computed.problems
    assert computed.modules["src/demo/__init__.py"].callees == []


