def test_check_fails_on_a_dropped_header_outside_src(tmp_path: Path) -> None:
    # "every module" is every module under the configured roots -- tests and scripts
    # included, so a header dropped there fails the same check.
    root = write_project(
        tmp_path / "outside",
        {
            "src/demo/a.py": mod("src/demo/a.py"),
            "tests/test_a.py": "VALUE = 1\n",
            "scripts/tool.py": "VALUE = 1\n",
        },
    )
    code, out = cli(root, "--check")
    assert code == 1
    assert "tests/test_a.py: no contract header" in out
    assert "scripts/tool.py: no contract header" in out
    assert "2 without a usable contract header" in out


