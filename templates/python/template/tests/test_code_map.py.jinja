def test_impact_gives_transitive_callers_and_callees(tmp_path: Path) -> None:
    graph = build_graph(
        {
            "src/demo/a.py": mod("src/demo/a.py", ["from . import b"]),
            "src/demo/b.py": mod("src/demo/b.py", ["from . import c"]),
            "src/demo/c.py": mod("src/demo/c.py"),
            "src/demo/d.py": mod("src/demo/d.py", ["from . import b"]),
            "src/demo/unrelated.py": mod("src/demo/unrelated.py"),
        },
        CONFIG,
    )
    assert graph.problems == []

    leaf = impact(graph, ["src/demo/c.py"])
    assert leaf.per[0].callers == ["src/demo/a.py", "src/demo/b.py", "src/demo/d.py"]
    assert leaf.per[0].callees == []

    top = impact(graph, ["src/demo/a.py"])
    assert top.per[0].callees == ["src/demo/b.py", "src/demo/c.py"]
    assert top.per[0].callers == []

    # the union over several changed files excludes the changed files themselves
    both = impact(graph, ["src/demo/b.py", "src/demo/c.py"])
    assert both.callers == ["src/demo/a.py", "src/demo/d.py"]
    assert both.callees == []

    # a path that is not a module is reported as such, not answered with an empty closure
    assert impact(graph, ["src/demo/nope.py"]).per[0].known is False

    # and through the real CLI
    root = write_project(
        tmp_path / "impact",
        {
            "src/demo/a.py": mod("src/demo/a.py", ["from . import b"]),
            "src/demo/b.py": mod("src/demo/b.py"),
        },
    )
    code, out = cli(root, "--impact", "src/demo/b.py")
    assert code == 0
    assert "transitive callers (1): src/demo/a.py" in out
    assert "transitive callees (0): —" in out


