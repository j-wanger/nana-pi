"""@module tests/test_code_map.py
@purpose Pin the code map -- the header parser, the renderer, the layer rules, the
  impact walk, and this project's own headers and rendered map.
@inputs the functions of scripts/code_map.py, fixture module sources, a scratch
  project carrying the real CLI, and this project root
@outputs pytest assertions and the check summary line on stdout
@effects disk (reads this project; writes scratch projects under the tmp dir), process (spawns the real CLI)
@errors none beyond assertion failures

The `req:` markers below are the trace rail's. In ADOPT mode they are emitted as
`req-candidate:` instead: nothing is claimed about this project until the audit
promotes the row, and then the marker is renamed to `req:`.

The failure paths run through the REAL CLI: a temp project gets a copy of
scripts/code_map.py plus a code-map.config.json, and the test spawns it there, so
what is checked is the command the suite and the post-edit gate actually run,
including its exit code.
"""

from __future__ import annotations

import json
import shutil
import subprocess
import sys
from pathlib import Path

import code_map
from code_map import (
    HEADER_TAGS,
    Config,
    ConfigError,
    build_graph,
    check_project,
    impact,
    load_config,
    map_entries,
    parse_config,
    parse_contract_header,
    render_map,
)

PROJECT = Path(__file__).resolve().parent.parent

FIXTURE_CONFIG = {
    # the same shape the template ships: the package, the scripts and the test root,
    # the test root exempt from the layer direction (G-007)
    "roots": ["src/demo", "scripts", {"path": "tests", "layerExempt": True}],
    "moduleExtensions": [".py"],
    "mapPath": "docs/code-map.md",
    "layers": [
        {"id": "tests", "title": "Tests", "blurb": "The suite.", "match": "^tests/"},
        {"id": "scripts", "title": "Scripts", "blurb": "The CLIs.", "match": "^scripts/"},
        {"id": "ui", "title": "UI", "blurb": "The screens.", "match": "^src/demo/ui/"},
        {"id": "api", "title": "API", "blurb": "The wire.", "match": "^src/demo/api/"},
        {"id": "core", "title": "Core", "blurb": "The model.", "match": "^src/demo/"},
    ],
}
CONFIG: Config = parse_config(json.dumps(FIXTURE_CONFIG))


def header(path: str, **over: str) -> str:
    """A well-formed contract header docstring for a module path."""
    fields = {
        "module": path,
        "purpose": "Do the one thing this module is for.",
        "inputs": "a thing",
        "outputs": "another thing",
        "effects": "none",
        "errors": "none",
        **over,
    }
    body = "\n".join(f"@{tag} {fields[tag]}" for tag in HEADER_TAGS)
    return f'"""{body}\n"""\n'


def mod(path: str, imports: list[str] | None = None, **over: str) -> str:
    """A fixture module: a header plus the given import statements."""
    return header(path, **over) + "".join(f"{line}\n" for line in (imports or []))


def write_project(root: Path, files: dict[str, str]) -> Path:
    """A temp project carrying the real CLI, so the spawned command is the real one."""
    (root / "scripts").mkdir(parents=True, exist_ok=True)
    shutil.copyfile(PROJECT / "scripts" / "code_map.py", root / "scripts" / "code_map.py")
    (root / "docs").mkdir(exist_ok=True)
    (root / "code-map.config.json").write_text(json.dumps(FIXTURE_CONFIG, indent=2), encoding="utf-8")
    for path, source in files.items():
        f = root / path
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(source, encoding="utf-8")
    return root


def cli(root: Path, *args: str) -> tuple[int, str]:
    """Run the real CLI in a project and return ``(exit code, output)``."""
    run = subprocess.run(  # noqa: S603
        [sys.executable, str(root / "scripts" / "code_map.py"), *args],
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    return run.returncode, run.stdout + run.stderr


{{ rq }} G-004
def test_contract_header_parses_into_six_fields() -> None:
    source = header(
        "src/demo/thing.py",
        effects="database (reads read-only), disk (writes the pointer)",
        errors="NotFound",
    )
    fields, problem = parse_contract_header(source + "\nVALUE = 1\n")
    assert problem is None, problem
    assert fields is not None
    assert list(fields) == list(HEADER_TAGS)
    assert fields["module"] == "src/demo/thing.py"
    # a parenthetical qualifier may carry commas without splitting the effects list
    assert fields["effects"] == "database (reads read-only), disk (writes the pointer)"


