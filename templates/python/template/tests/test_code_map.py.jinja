def test_rendered_map_carries_one_entry_per_module() -> None:
    graph = build_graph(
        {
            "src/demo/__init__.py": mod("src/demo/__init__.py"),
            "src/demo/api/ops.py": mod("src/demo/api/ops.py", ["from ..core import model"]),
            "src/demo/core/model.py": mod("src/demo/core/model.py"),
            "src/demo/ui/screen.py": mod("src/demo/ui/screen.py", ["from demo.api import ops"]),
        },
        CONFIG,
    )
    assert graph.problems == []
    markdown = render_map(graph)
    assert sorted(map_entries(markdown)) == [
        "src/demo/__init__.py",
        "src/demo/api/ops.py",
        "src/demo/core/model.py",
        "src/demo/ui/screen.py",
    ]
    # the ui entry comes before the api entry, which comes before the core ones
    at = markdown.index
    assert at("### `src/demo/ui/screen.py`") < at("### `src/demo/api/ops.py`")
    assert at("### `src/demo/api/ops.py`") < at("### `src/demo/core/model.py`")
    assert "- **callers** — `src/demo/ui/screen.py`" in markdown
    assert "- **callees** — `src/demo/core/model.py`" in markdown
    # deterministic: rendering the same graph twice gives the same bytes
    assert render_map(graph) == markdown


def test_relative_and_absolute_intra_package_imports_both_resolve() -> None:
    sources = {
        "src/demo/__init__.py": mod("src/demo/__init__.py", ["from .core import model"]),
        "src/demo/core/__init__.py": mod("src/demo/core/__init__.py"),
        "src/demo/core/model.py": mod("src/demo/core/model.py", ["import demo.core.helper"]),
        "src/demo/core/helper.py": mod("src/demo/core/helper.py", ["import json"]),
    }
    graph = build_graph(sources, CONFIG)
    assert graph.problems == []
    assert graph.modules["src/demo/__init__.py"].callees == ["src/demo/core/model.py"]
    assert graph.modules["src/demo/core/model.py"].callees == ["src/demo/core/helper.py"]
    # an intra-package import that resolves to nothing is a problem, a stdlib one is not
    dangling = build_graph({"src/demo/a.py": mod("src/demo/a.py", ["from .gone import x"])}, CONFIG)
    assert any("does not resolve to a mapped module" in p for p in dangling.problems)


def test_a_reverse_or_layer_skipping_import_is_a_problem() -> None:
    # NOTE: G-007 is deliberately NOT claimed by this project. These fixtures pin
    # the CHECK, not this project's own layering, so that row stays `untested`
    # until the project declares real layers and a test pins them.
    reverse = build_graph(
        {
            "src/demo/api/ops.py": mod("src/demo/api/ops.py", ["from ..ui import screen"]),
            "src/demo/ui/screen.py": mod("src/demo/ui/screen.py"),
        },
        CONFIG,
    )
    assert any("against the layer direction (api -> ui)" in p for p in reverse.problems)

    skipping = build_graph(
        {
            "src/demo/ui/screen.py": mod("src/demo/ui/screen.py", ["from ..core import model"]),
            "src/demo/core/model.py": mod("src/demo/core/model.py"),
        },
        CONFIG,
    )
    assert any("SKIPPING a layer (ui -> core, past api)" in p for p in skipping.problems)

    adjacent = build_graph(
        {
            "src/demo/ui/screen.py": mod("src/demo/ui/screen.py", ["from ..api import ops"]),
            "src/demo/api/ops.py": mod("src/demo/api/ops.py"),
        },
        CONFIG,
    )
    assert adjacent.problems == []


def test_a_test_may_import_any_layer_but_nothing_below_may_import_a_test() -> None:
    # G-007 says tests may import anything: the test root is declared layerExempt, so a
    # test reaching past a layer is fine while a module reaching INTO tests is not.
    exempt = build_graph(
        {
            "tests/test_model.py": mod("tests/test_model.py", ["from demo.core import model"]),
            "src/demo/core/model.py": mod("src/demo/core/model.py"),
        },
        CONFIG,
    )
    assert exempt.problems == []
    assert exempt.modules["src/demo/core/model.py"].callers == ["tests/test_model.py"]

    inward = build_graph(
        {
            "src/demo/core/model.py": mod("src/demo/core/model.py", ["from tests import test_model"]),
            "tests/test_model.py": mod("tests/test_model.py"),
        },
        CONFIG,
    )
    assert any("against the layer direction (core -> tests)" in p for p in inward.problems)


