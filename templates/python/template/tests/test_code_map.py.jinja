def test_an_exemption_must_name_a_real_module_and_say_why() -> None:
    no_reason = parse_config(json.dumps({**FIXTURE_CONFIG, "exempt": [{"path": "src/demo/a.py"}]}))
    graph = build_graph({"src/demo/a.py": "ROWS = []\n"}, no_reason)
    assert any("exempt path 'src/demo/a.py' has no reason" in p for p in graph.problems)

    gone = parse_config(json.dumps({**FIXTURE_CONFIG, "exempt": [{"path": "src/demo/gone.py", "reason": "pinned"}]}))
    graph = build_graph({"src/demo/a.py": mod("src/demo/a.py")}, gone)
    assert any("exempt path 'src/demo/gone.py' is not a module" in p for p in graph.problems)

    # a malformed entry is a config error, not a silent skip
    try:
        parse_config(json.dumps({**FIXTURE_CONFIG, "exempt": [{"reason": "no path"}]}))
    except ConfigError as err:
        assert "exempt[0] must be an object with a non-empty 'path'" in str(err)
    else:  # pragma: no cover - the assertion above is the point
        raise AssertionError("a malformed exempt entry must raise")


def test_test_roots_is_shorthand_for_a_layer_exempt_root() -> None:
    config = parse_config(
        json.dumps({**FIXTURE_CONFIG, "roots": ["src/demo", "scripts", "tests"], "testRoots": ["tests"]})
    )
    assert config.is_layer_exempt("tests/test_a.py")
    graph = build_graph(
        {
            "tests/test_a.py": mod("tests/test_a.py", ["from demo.core import model"]),
            "src/demo/core/model.py": mod("src/demo/core/model.py"),
        },
        config,
    )
    assert graph.problems == []
    try:
        parse_config(json.dumps({**FIXTURE_CONFIG, "testRoots": ["nope"]}))
    except ConfigError as err:
        assert "is not one of 'roots'" in str(err)
    else:  # pragma: no cover
        raise AssertionError("a testRoots entry outside roots must raise")


