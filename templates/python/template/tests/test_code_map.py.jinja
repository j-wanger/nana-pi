def test_a_malformed_contract_header_is_a_named_problem() -> None:
    cases = [
        ("VALUE = 1\n", "no contract header"),
        ('"""@module src/demo/a.py\n@purpose One.\n@inputs i\n@outputs o\n@errors none\n"""\n', "no @effects"),
        (
            '"""@module src/demo/a.py\n@inputs i\n@purpose One.\n@outputs o\n@effects none\n@errors none\n"""\n',
            "out of order",
        ),
        (header("src/demo/a.py", effects="filesystem"), "is not one of none | disk"),
        (header("src/demo/a.py", effects="none, disk"), "'none' alongside disk"),
        (header("src/demo/a.py", purpose="One thing. And a second thing."), "more than one sentence"),
        (header("src/demo/a.py", inputs=""), "@inputs is empty"),
        ('"""Just prose, no tags."""\n', "must open with @module"),
    ]
    for source, expected in cases:
        fields, problem = parse_contract_header(source)
        assert fields is None, f"expected a problem for: {source[:40]!r}"
        assert problem is not None
        assert expected in problem, f"{expected!r} not in {problem!r}"
    # a header naming the wrong path is a graph problem, not a parse one
    graph = build_graph({"src/demo/a.py": mod("src/demo/b.py")}, CONFIG)
    assert any("the header's @module says 'src/demo/b.py'" in p for p in graph.problems)


