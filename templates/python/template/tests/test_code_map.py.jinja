def test_a_declared_exemption_keeps_the_module_in_the_map_without_a_header(tmp_path: Path) -> None:
    # A module whose CONTENT is pinned elsewhere (a fixture a published study hashes)
    # cannot take a header without invalidating that pin. It stays mapped and keeps its
    # edges; what it loses is the header -- and it has to say why.
    config = {
        **FIXTURE_CONFIG,
        "exempt": [{"path": "src/demo/pinned.py", "reason": "content-pinned by study sha256 abc123"}],
    }
    pinned = parse_config(json.dumps(config))
    graph = build_graph(
        {
            "src/demo/__init__.py": mod("src/demo/__init__.py", ["from . import pinned"]),
            "src/demo/pinned.py": "ROWS = [1, 2, 3]\n",
        },
        pinned,
    )
    assert graph.problems == []
    assert graph.modules["src/demo/pinned.py"].exempt_reason == "content-pinned by study sha256 abc123"
    markdown = render_map(graph)
    assert "src/demo/pinned.py" in map_entries(markdown)
    assert "- **exempt** — content-pinned by study sha256 abc123" in markdown
    assert "- **purpose**" not in markdown.split("### `src/demo/pinned.py`")[1]
    # the edge still counts, so --impact still sees it
    assert graph.modules["src/demo/pinned.py"].callers == ["src/demo/__init__.py"]

    # through the real CLI: the exempt module is exempt, not headerless
    root = tmp_path / "exempt"
    (root / "scripts").mkdir(parents=True)
    shutil.copyfile(PROJECT / "scripts" / "code_map.py", root / "scripts" / "code_map.py")
    (root / "docs").mkdir()
    (root / "code-map.config.json").write_text(json.dumps(config, indent=2), encoding="utf-8")
    (root / "src" / "demo").mkdir(parents=True)
    (root / "src" / "demo" / "pinned.py").write_text("ROWS = [1, 2, 3]\n", encoding="utf-8")
    cli(root)
    code, out = cli(root, "--check")
    assert code == 0, out
    assert "0 without a usable contract header; 1 exempt" in out


