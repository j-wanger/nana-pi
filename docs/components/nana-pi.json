      ],
      "features": [
        "FEAT-003",
        "FEAT-004"
      ],
      "status": "gap",
      "gap": "The shared index descriptions are already cut to stubs at every session start; at about 125 entries, newest whole entries begin dropping. nana-pi stores and reviews durable records, but does not search them as memory.",
      "ask": {
        "question": "Should shared memory move from a printed index to a searched, reviewed store?",
        "default": "keep the printed index",
        "gains": "No new moving part; misses the descriptions already cut to stubs and the newest entries beyond the cap.",
        "cost": "Easy to undo",
        "otherwise": "Plan a searched-store lane that can evaluate the machine-local memory MCP tools as prior art."
      },
      "evidence": [
        "packages/nana-setup/claude/hooks/nana-shared-memory.mjs",
        "R-2343"
      ],
      "auditedAt": "a2ad3f2121ae96aa0eb6e70d12d060d5918714c7",
      "anchors": [
        "measured 2026-10-29: 80 entries; about 16,700 characters; 9,000-character budget"
